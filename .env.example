# ============================================================
# SafeBus Web — environment template
# Copy to `.env` (local only — never commit real .env files).
# ============================================================

# SQLite database consumed by the Next.js BFF layer (Prisma).
# Use a path that exists in your deployment; run `bun run db:push`
# once to materialise the schema.
DATABASE_URL=file:./db/custom.db

# Auth cookie partitioning mode.
#   1 (default) — CHIPS cookies for cross-site iframe embedding
#                 (SameSite=None; Secure; Partitioned). Required when the
#                 app is rendered inside another origin's iframe
#                 (e.g. sandboxed preview panels).
#   0           — first-party deployment cookies (SameSite=Lax).
#                 Use this for normal standalone hosting.
AUTH_COOKIE_EMBEDDED=0
